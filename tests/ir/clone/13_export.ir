;; 13_export.ir (clone phase) — ifa/issues/212: an exported function gets ONE
;; EntrySet. Nothing but its root calls it, so nothing demands a split.
;; The codegen-c fixture of the same name, without `observe` (only the
;; codegen phases register it).

(sym %x :is-local)
(sym %y :is-local)
(sym %one :is-constant :immediate (int64 1))
(sym %s :is-local)
(sym %cbcont)
(fun %cb
  :args (%cb %x %y)
  :rets (%s)
  :cont %cbcont
  :export "cb_add"
  :export-args (@int64 @int64)
  :export-ret @int64
  :body
    (send @operator %x #+ %one => %s)
    (send @primitive @reply %cbcont %s))

(sym %k :is-constant :immediate (int32 7))
(sym %r :is-local)
(sym %tcont)
(fun %top
  :rets (%r)
  :cont %tcont
  :body
    (move %k %r)
  )

(entry %top)
