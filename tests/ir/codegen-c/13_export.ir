;; 13_export.ir — ifa/issues/212: an exported function. Nothing in the
;; program calls %cb; code outside it calls `cb_add(int64, int64)`. FA
;; roots it as that outside caller, and codegen emits `cb_add` forwarding
;; to %cb's one clone. %y is dead in the body, so the clone drops it and
;; the entry point still takes it.

(sym %x :is-local)
(sym %y :is-local)
(sym %one :is-constant :immediate (int64 1))
(sym %s :is-local)
(sym %cbcont)
(fun %cb
  :args (%cb %x %y)
  :rets (%s)
  :cont %cbcont
  :export "cb_add"
  :export-args (@int64 @int64)
  :export-ret @int64
  :body
    (send @operator %x #+ %one => %s)
    (send @primitive @reply %cbcont %s))

(sym %k :is-constant :immediate (int32 7))
(sym %r :is-local)
(sym %o :is-local)
(sym %tcont)
(fun %top
  :rets (%r)
  :cont %tcont
  :body
    (move %k %r)
    (send @primitive #observe %r => %o))

(entry %top)
