;; 04_getter.ir — the P_prim_period (getter) path. Allocates a %Point,
;; writes %k (int32) into %px, reads it back through the period
;; primitive, and observes the read. The store survives because the
;; read uses it; this is the fixture that shows a field GEP, store and
;; load on both backends.

(type %Point :kind RECORD :has (%px))
(sym %px :in %Point)

(sym %k :is-constant :immediate (int32 42))

(sym %p :is-local)
(sym %s :is-local)
(sym %r :is-local)
(sym %o :is-local)
(sym %tcont)
(fun %top
  :rets (%r)
  :cont %tcont
  :body
    (send @primitive @new %Point => %p)
    (send @operator %p @setter #px %k => %s)
    (send @operator %p @period #px => %r)
    (send @primitive #observe %r => %o))

(entry %top)
