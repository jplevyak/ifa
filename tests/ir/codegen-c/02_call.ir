;; 02_call.ir — a typed int32 call. %add replies its first argument;
;; the inliner folds the call, so the golden shows `t0 = 1` handed to
;; `observe`. Until 2026-11-14 %add had no `reply`, so its result was
;; untyped; nothing read it, so nothing noticed.

(sym %k1 :is-constant :immediate (int32 1))
(sym %k2 :is-constant :immediate (int32 2))

(sym %a :is-local)
(sym %b :is-local)
(sym %ar :is-local)
(sym %acont)
(fun %add
  :args (%add %a %b)
  :rets (%ar)
  :cont %acont
  :body
    (move %a %ar)
    (send @primitive @reply %acont %ar))

(sym %r :is-local)
(sym %o :is-local)
(sym %tcont)
(fun %top
  :rets (%r)
  :cont %tcont
  :body
    (send %add %k1 %k2 => %r)
    (send @primitive #observe %r => %o))

(entry %top)
