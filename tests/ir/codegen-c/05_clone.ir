;; 05_clone.ir — the P_prim_clone path: `_CG_prim_clone_dst` in C, a
;; GC_malloc + memcpy in LLVM. The clone is observed; the field store
;; before it is dead (nothing reads %px).

(type %Point :kind RECORD :has (%px))
(sym %px :in %Point)

(sym %k :is-constant :immediate (int32 7))

(sym %p :is-local)
(sym %s :is-local)
(sym %c :is-local)
(sym %r :is-local)
(sym %o :is-local)
(sym %tcont)
(fun %top
  :rets (%r)
  :cont %tcont
  :body
    (send @primitive @new %Point => %p)
    (send @operator %p @setter #px %k => %s)
    (send @primitive @clone %p => %c)
    (move %c %r)
    (send @primitive #observe %r => %o))

(entry %top)
