;; pass-limit: 0
;; 06_pass_cap_settles.ir — 03_cascade.ir with the pass cap at 0, so the
;; cap stops the analysis in the same pass whose type stage splits %fwd:
;; the split rebinds %fwd's call of %add to a new, not yet analyzed
;; EntrySet. FA must run one more (split-free) pass before returning, or
;; clone() binds that call to an arbitrary clone of %add (in langwb, a list
;; length fold called the list-reversing fold's clone).
;;
;; Expected: unanalyzed-edges 0.

(sym %k_i :is-constant :immediate (int32 1))
(sym %k_j :is-constant :immediate (int32 2))
(sym %k_f :is-constant :immediate (float64 1.5))
(sym %k_g :is-constant :immediate (float64 2.5))

;; %add: bottom of the call chain.
(sym %a :is-local)
(sym %b :is-local)
(sym %ar :is-local)
(sym %acont)
(fun %add
  :args (%add %a %b)
  :rets (%ar)
  :cont %acont
  :body
    (move %a %ar))

;; %fwd: forwards its args to %add.
(sym %x :is-local)
(sym %y :is-local)
(sym %fr :is-local)
(sym %fcont)
(fun %fwd
  :args (%fwd %x %y)
  :rets (%fr)
  :cont %fcont
  :body
    (send %add %x %y => %fr))

(sym %r1 :is-local)
(sym %r2 :is-local)
(sym %tcont)
(fun %top
  :rets (%r1)
  :cont %tcont
  :body
    (send %fwd %k_i %k_j => %r1)
    (send %fwd %k_f %k_g => %r2))

(entry %top)
