;; 04_arity.ir -- ifa/185: dispatch on tuple arity.
;;
;; Three candidates for `m`: %m2 and %m3 constrain their formal to a
;; tuple of arity 2 and 3 (:dispatch-arity), %mn takes any tuple. A
;; 2-tuple matches %m2 and %mn, and subsumption prefers the constrained
;; one; a 3-tuple goes to %m3; a 1-tuple matches only %mn.
;;
;; Expected: m t2 -> %m2, m t3 -> %m3, m t1 -> %mn; rc=0, ess=4.

(sym %k1 :is-constant :immediate (int32 1))
(sym %k2 :is-constant :immediate (int32 2))

(sym %s2 :is-local :must-specialize @tuple :dispatch-arity 2)
(sym %r2 :is-local)
(sym %c2)
(fun %m2
  :args (#m %s2)
  :rets (%r2)
  :cont %c2
  :body
    (move %s2 %r2))

(sym %s3 :is-local :must-specialize @tuple :dispatch-arity 3)
(sym %r3 :is-local)
(sym %c3)
(fun %m3
  :args (#m %s3)
  :rets (%r3)
  :cont %c3
  :body
    (move %s3 %r3))

(sym %sn :is-local :must-specialize @tuple)
(sym %rn :is-local)
(sym %cn)
(fun %mn
  :args (#m %sn)
  :rets (%rn)
  :cont %cn
  :body
    (move %sn %rn))

(sym %t2 :is-local)
(sym %t3 :is-local)
(sym %t1 :is-local)
(sym %u1 :is-local)
(sym %u2 :is-local)
(sym %u3 :is-local)
(sym %tcont)
(fun %top
  :rets (%u2)
  :cont %tcont
  :body
    (send @primitive @make @tuple %k1 %k2 => %t2)
    (send @primitive @make @tuple %k1 %k2 %k1 => %t3)
    (send @primitive @make @tuple %k1 => %t1)
    (send #m %t2 => %u2)
    (send #m %t3 => %u3)
    (send #m %t1 => %u1))

(entry %top)
